@using UniversityApp.Controllers
@model CourseEntity
@{
    ViewData["Title"] = "Edit Course";
}

<h1>Edit Course</h1>
<form asp-action="Edit" asp-route-id="@Model.RowKey" method="post">
    <input type="hidden" asp-for="RowKey" />
    <div class="mb-3">
        <label>Course Name</label>
        <input asp-for="CourseName" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Instructor</label>
        <input asp-for="Instructor" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
