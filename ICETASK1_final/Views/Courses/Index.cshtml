@using UniversityApp.Controllers
@model List<CourseEntity>
@{
    ViewData["Title"] = "Courses";
}

<h1>Available Courses</h1>
<a asp-action="Create" class="btn btn-primary mb-3">Add a Course</a>

<table class="table">
    <thead>
        <tr><th>Course Name</th><th>Instructor</th><th>Enroll a Student</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.CourseName</td>
                <td>@course.Instructor</td>
                <td>
                    <form asp-action="Enroll" method="post" class="d-flex">
                        <input type="hidden" name="courseId" value="@course.RowKey" />
                        <input type="text" name="studentId" placeholder="Student RowKey" class="form-control me-2" required />
                        <button type="submit" class="btn btn-sm btn-success">Enroll</button>
                    </form>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@course.RowKey" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@course.RowKey" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
